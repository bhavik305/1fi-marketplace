# Copy this file to .env.local and fill in real values for local development.
# NEVER commit a populated .env.local — it is git-ignored.

# Optional: force the mock API to fail in development to demo error states.
# Leave unset/empty to keep the mock API healthy.
# EXPO_PUBLIC_FORCE_API_ERROR=1

# Optional: override the simulated API delay (milliseconds). Defaults to 400.
# EXPO_PUBLIC_MOCK_API_DELAY_MS=400